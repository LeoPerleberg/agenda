{
    "name": "agenda-react",
    "version": "1.0.0",
    "description": "Agenda simples de compromissos escrita em React, com persistência em arquivo JSON local.",
    "private": true,
    "engines": {
        "node": ">=20.19.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "api": "node server/server.js",
        "build": "webpack --config webpack.prod.js",
        "dev": "concurrently -k -n api,web \"npm run api\" \"webpack serve --open --config webpack.dev.js\"",
        "start": "npm run build && node server/server.js"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.29.3",
        "@babel/preset-react": "^7.28.5",
        "@playwright/test": "^1.64.0",
        "babel-loader": "^10.1.1",
        "concurrently": "^9.2.1",
        "css-loader": "^7.1.4",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "html-webpack-plugin": "^5.6.7",
        "mini-css-extract-plugin": "^2.10.2",
        "style-loader": "^4.0.0",
        "terser-webpack-plugin": "^5.3.14",
        "webpack": "^5.106.2",
        "webpack-cli": "^7.0.2",
        "webpack-dev-server": "^5.2.3",
        "webpack-merge": "^6.0.1"
    },
    "dependencies": {
        "react": "^19.2.5",
        "react-dom": "^19.2.5"
    }
}
